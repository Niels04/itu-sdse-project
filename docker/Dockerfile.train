FROM python:3.13-slim
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir -e .
COPY src/ ./src/
# Training logs to the local MLflow state directory (no tracking server -
# see src/config.py). Mount a volume at /app/mlflow-state to keep the run
# history and model registry across runs.
CMD ["sh", "-c", "python -m src.pipeline && python -m src.deployment.export"]
