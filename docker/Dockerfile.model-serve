FROM python:3.13-slim
WORKDIR /app

# CPU-only torch keeps the image small; inference does not use CUDA
RUN pip install --no-cache-dir torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu

# Install the project package so the pickled pyfunc model
# (src.deployment.logging_wrapper) is importable in the serving process
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir .

# pyfunc model committed by the CI train job
COPY models/model /app/models/model

# Baseline statistics written during training; the /drift endpoint of
# src.deployment.serve compares live inference logs against them
COPY artifacts/drift_baseline_stats.json /app/artifacts/drift_baseline_stats.json

# App Platform component-to-component address of the tracking service
ENV MLFLOW_TRACKING_URI=http://mlflow-tracking:5000
EXPOSE 5001

# One worker: importing torch is slow and memory-heavy, and several
# workers make the readiness probe time out on the 512 MiB instance.
# src.deployment.serve fronts the scoring server with a JSON /health
# response (MLflow's own /health returns a bare newline) and proxies
# /invocations to the scoring server on the internal UPSTREAM_PORT.
CMD ["python", "-m", "src.deployment.serve"]
